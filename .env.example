# ---- 本地开发（pnpm dev）----
# 指向本机 Postgres
DATABASE_URL=postgres://payload:payload@localhost:5432/crdocs

# ---- Docker Compose 部署会用到的变量（写在 .env 里，compose 自动读取）----
# 数据库凭据（compose 里的 db 服务与 DATABASE_URL 都会用到）
POSTGRES_USER=payload
POSTGRES_PASSWORD=payload
POSTGRES_DB=crdocs
# 对外暴露端口
WEB_PORT=3000

# Payload 密钥：务必改成随机长字符串（可用 `openssl rand -hex 32` 生成）
PAYLOAD_SECRET=YOUR_SECRET_HERE

# 种子脚本创建的初始管理员（scripts/seed.ts 读取；登录后请立即改密码）
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme123

# 浏览器打开 /admin 时用的源，会写进 Payload 的 csrf 白名单。
# 漏配的典型症状：登录接口返回 200，但后台「闪一下」又弹回登录页
# （/api/users/me 返回 user:null，因为 cookie 的来源不被信任）。
# 换端口 / 换域名 / 用 IP 访问后台，都要把对应来源加进来，逗号分隔。
ADMIN_ORIGINS=http://localhost:8300
